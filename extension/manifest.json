{
  "manifest_version": 3,
  "name": "GPT Interceptor",
  "version": "1.0.0",
  "description": "Intercepta mensagens do ChatGPT",
  "permissions": [
    "scripting",
    "webRequest",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GPT Interceptor"
  }
}
